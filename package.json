{
  "name": "mbti-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @mbti/web dev",
    "dev:api": "pnpm --filter @mbti/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "docker:local:up": "docker compose -p mbti-local -f docker-compose.local.yml up -d --build",
    "docker:local:down": "docker compose -p mbti-local -f docker-compose.local.yml down",
    "docker:local:logs": "docker compose -p mbti-local -f docker-compose.local.yml logs -f",
    "docker:prod:up": "docker compose -p mbti-prod -f docker-compose.prod.yml --env-file .env.prod up -d --build",
    "docker:prod:down": "docker compose -p mbti-prod -f docker-compose.prod.yml --env-file .env.prod down",
    "docker:prod:logs": "docker compose -p mbti-prod -f docker-compose.prod.yml --env-file .env.prod logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.13.9",
    "eslint": "^9.21.0",
    "globals": "^16.5.0",
    "prettier": "^3.5.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.46.3",
    "vitest": "^3.0.8"
  }
}
